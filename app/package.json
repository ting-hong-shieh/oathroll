{
  "name": "oathroll",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-art.mjs && node scripts/select-backend.mjs",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 0.0.0.0",
    "prebuild": "node scripts/sync-art.mjs && node scripts/select-backend.mjs",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.2",
    "@anthropic-ai/sdk": "^1.6.0",
    "@solana/web3.js": "^1.99.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "toml": "5.0.1"
  }
}
